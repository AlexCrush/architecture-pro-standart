<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="Схема интеграции" name="Схема интеграции">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Схема интеграции приложений as-is. Открытие депозита и кредитная заявка." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1900" height="34" as="geometry"/></mxCell>
<mxCell id="3" value="Жёлтые блоки — участники. Синие — системы банка. Зелёный — АБС. Серый пунктир — внешняя система. Пунктирная стрелка — почта, Excel или ночная выгрузка базы. Серая стрелка — связь есть, но к этим двум процессам не относится." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fontColor=#1a1a1a;strokeColor=#c5cad3;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1920" height="52" as="geometry"/></mxCell>
<mxCell id="4" value="Открытие депозита" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfe;strokeColor=#c5cad3;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="1940" height="820" as="geometry"/></mxCell>
<mxCell id="5" value="Клиент" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="180" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="6" value="Оператор&lt;br&gt;кол-центра" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="310" width="230" height="64" as="geometry"/></mxCell>
<mxCell id="7" value="Система&lt;br&gt;кол-центра банка" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="8" value="Сотрудник&lt;br&gt;отделения" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="250" height="64" as="geometry"/></mxCell>
<mxCell id="9" value="Менеджер&lt;br&gt;бэк-офиса депозитов" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="450" width="250" height="70" as="geometry"/></mxCell>
<mxCell id="10" value="Почта&lt;br&gt;&lt;br&gt;Каждый день: Excel базовых ставок от кредитного блока в депозиты.&lt;br&gt;Без звонка: отделение просит ставку у депозитов.&lt;br&gt;Спецставка: депозиты спрашивают кредитный блок, тот отвечает риском клиента из своего раздела АБС. Депозиты считают ставку в Excel и письмом отдают её в отделение.&lt;br&gt;Данные друг друга два бэк-офиса не видят." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="460" height="250" as="geometry"/></mxCell>
<mxCell id="11" value="Сотрудник бэк-офиса кредитов&lt;br&gt;в АБС видит только раздел кредитного риска клиента" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="180" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="12" value="Excel&lt;br&gt;базовая ставка каждый день&lt;br&gt;и спецставка по запросу" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="360" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="13" value="Сотрудник&lt;br&gt;партнёрского кол-центра" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="180" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="14" value="Система партнёра&lt;br&gt;внешняя&lt;br&gt;интеграции с банком нет" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1580" y="300" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="15" value="Бизнес-представители банка передают партнёру только готовые скрипты звонков." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fontColor=#1a1a1a;strokeColor=#c5cad3;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1580" y="410" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="16" value="АБС — одна система банка&lt;br&gt;Delphi, Oracle, логика на PL/SQL&lt;br&gt;депозит, фиксация ставки, отдельный раздел кредитного риска клиента" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="1100" height="90" as="geometry"/></mxCell>
<mxCell id="17" value="Сотрудник отделения&lt;br&gt;создаёт депозит и загружает подписанные документы" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="600" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="18" value="SMS-шлюз&lt;br&gt;банка" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="760" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="19" value="Телеком-&lt;br&gt;оператор" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="760" width="180" height="64" as="geometry"/></mxCell>
<mxCell id="20" value="Клиент&lt;br&gt;получает СМС" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="760" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="21" value="В СМС ставка и приглашение в отделение. Клиент ждёт в отделении, пока ставку назовут: обычно 20 минут, спецставка — до часа." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fontColor=#1a1a1a;strokeColor=#c5cad3;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="750" width="680" height="90" as="geometry"/></mxCell>
<mxCell id="35" value="Кредитная заявка" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfe;strokeColor=#c5cad3;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="970" width="1940" height="560" as="geometry"/></mxCell>
<mxCell id="36" value="Клиент" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1040" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="37" value="Сотрудник&lt;br&gt;отделения" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="1040" width="210" height="64" as="geometry"/></mxCell>
<mxCell id="38" value="АБС&lt;br&gt;та же система" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="1030" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="39" value="Кредитный конвейер&lt;br&gt;Camunda, Oracle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="1030" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="40" value="Сотрудник&lt;br&gt;бэк-офиса кредитов" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="1030" width="240" height="70" as="geometry"/></mxCell>
<mxCell id="41" value="Скоринг&lt;br&gt;Python, Flask, PostgreSQL&lt;br&gt;онлайн API; раз в сутки — номера платежей из конвейера" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="1220" width="280" height="100" as="geometry"/></mxCell>
<mxCell id="42" value="Бюро кредитных&lt;br&gt;историй" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 4;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="1230" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="43" value="Решение принимает сотрудник в конвейере по оценке скоринга и параметрам заявки. После финального статуса АБС зачисляет деньги на счёт клиента." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fontColor=#1a1a1a;strokeColor=#c5cad3;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="1200" width="520" height="110" as="geometry"/></mxCell>
<mxCell id="44" value="Пунктир между системами — выгрузка базы раз в сутки, чаще её не делают. АБС отдаёт в конвейер заявки, конвейер возвращает в АБС финальный статус. В скоринг раз в сутки попадают клиенты и платежи из АБС (платежи лежат в АБС) и номера платежей из конвейера (они лежат там). Онлайн только API скоринга в момент рассмотрения и REST бюро в момент скоринга." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fontColor=#1a1a1a;strokeColor=#c5cad3;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="1360" width="1880" height="130" as="geometry"/></mxCell>
<mxCell id="52" value="Уже есть. В депозит и кредит не входит" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfcfe;strokeColor=#c5cad3;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="1560" width="1940" height="190" as="geometry"/></mxCell>
<mxCell id="53" value="Сайт&lt;br&gt;PHP, React.js&lt;br&gt;только маркетинг&lt;br&gt;интеграций нет" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1610" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="54" value="Интернет-банк&lt;br&gt;ASP.NET MVC, .NET Framework 4.5&lt;br&gt;MS SQL, монолит подрядчика" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="1610" width="360" height="110" as="geometry"/></mxCell>
<mxCell id="55" value="АБС&lt;br&gt;та же система" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="1620" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="56" value="Прямая интеграция с базой АБС: платежи и открытие текущих счетов. Один рабочий ЦОД и резервный ЦОД." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f8fa;fontColor=#1a1a1a;strokeColor=#c5cad3;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="1620" width="780" height="90" as="geometry"/></mxCell>
<mxCell id="22" value="звонок" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="23" value="создаёт обращение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="24" value="обращение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="25" value="или визит сразу" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="26" value="запрос ставки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#b58900;fontColor=#6b4f00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="225"/><mxPoint x="640" y="288"/></Array></mxGeometry></mxCell>
<mxCell id="27" value="фиксирует ставку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="28" value="спецставка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#b58900;fontColor=#6b4f00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="29" value="считает ставку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="30" value="файл" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;strokeColor=#b58900;fontColor=#6b4f00;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="31" value="в АБС" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="17" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="32" value="СМС о ставке" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="16" target="18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="33" value="отправка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="18" target="19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="34" value="прийти в отделение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="19" target="20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="45" value="визит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="36" target="37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="46" value="оформляет заявку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontColor=#1a1a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="37" target="38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
