  <diagram id="Карта IT-ландшафта" name="Карта IT-ландшафта">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="2078" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Карта IT-ландшафта as-is. Строки — оргструктура, колонки — бизнес-возможности второго уровня." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="30" y="24" width="1870" height="40" as="geometry"/></mxCell>
<mxCell id="3" value="Продажи и маркетинг" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e4b9b;fontColor=#ffffff;strokeColor=#1e4b9b;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="810" height="36" as="geometry"/></mxCell>
<mxCell id="4" value="Поддержка операционных процессов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e4b9b;fontColor=#ffffff;strokeColor=#1e4b9b;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="810" height="36" as="geometry"/></mxCell>
<mxCell id="5" value="Подразделение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e4b9b;fontColor=#ffffff;strokeColor=#1e4b9b;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="250" height="114" as="geometry"/></mxCell>
<mxCell id="6" value="Продажи&lt;br&gt;в сети отделений" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6e4ff;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="126" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="7" value="Продажи&lt;br&gt;через кол-центр" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6e4ff;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="126" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="8" value="Digital-оповещения&lt;br&gt;клиентов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6e4ff;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="126" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="9" value="Обслуживание&lt;br&gt;депозитных процессов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6e4ff;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="126" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="10" value="Обслуживание&lt;br&gt;кредитных процессов" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6e4ff;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="126" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="11" value="Управление&lt;br&gt;договорами" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d6e4ff;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="126" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="12" value="Управление обслуживанием в сети отделений&lt;br&gt;&lt;br&gt;фронт-офис&lt;br&gt;50 отделений" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef8;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="13" value="АБС, десктоп-клиент.&lt;br&gt;Клиент подаёт заявку на депозит или кредит только лично в отделении." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="204" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="14" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="204" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="15" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="204" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="16" value="АБС: сотрудник открывает депозит и после подписи загружает документы.&lt;br&gt;Почта в бэк-офис депозитов, если ставка не подготовлена заранее.&lt;br&gt;Клиент ждёт в отделении: обычно 20 минут, при спецставке до часа." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="204" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="17" value="АБС: сотрудник регистрирует заявку на кредит и сообщает, что её рассмотрит банк." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="204" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="18" value="АБС: договор и сканы документов клиента." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1630" y="204" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="19" value="Кол-центр банка «Стандарт»&lt;br&gt;&lt;br&gt;200 операторов&lt;br&gt;система подрядчика" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef8;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="434" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="20" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="434" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="21" value="Система кол-центра.&lt;br&gt;Если клиент звонит уточнить депозит, оператор заводит обращение." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="434" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="22" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="434" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="23" value="Обращение из системы кол-центра передаётся в АБС.&lt;br&gt;Дальше ставку заранее фиксирует бэк-офис депозитов." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="434" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="24" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="434" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="25" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="434" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="26" value="Партнёрский кол-центр&lt;br&gt;&lt;br&gt;внешняя организация&lt;br&gt;100 человек" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef8;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="664" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="27" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="664" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="28" value="Внешняя система партнёра.&lt;br&gt;Только готовые скрипты, которые передают бизнес-представители банка.&lt;br&gt;Интеграции с системами банка нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="664" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="29" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="664" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="30" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="664" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="31" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="664" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="32" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1630" y="664" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="33" value="Управление обслуживанием депозитных продуктов&lt;br&gt;&lt;br&gt;бэк-офис" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef8;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="894" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="34" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="894" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="35" value="АБС: обработка обращений из кол-центра и фиксация ставки для клиента." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="894" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="36" value="После фиксации ставки АБС отправляет клиенту СМС: депозит можно оформить в отделении." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="894" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="37" value="АБС — учёт обращения и депозита.&lt;br&gt;Excel — только спецставки.&lt;br&gt;Почта: ежедневный файл базовых ставок от кредитного блока и запросы отделений.&lt;br&gt;К кредитным данным прямого доступа нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="894" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="38" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1360" y="894" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="39" value="АБС: депозитный договор." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1630" y="894" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="40" value="Управление обслуживанием кредитных продуктов&lt;br&gt;&lt;br&gt;бэк-офис" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef8;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1124" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="41" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="1124" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="42" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1124" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="43" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="1124" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="44" value="Excel: каждый день считает базовую ставку депозита по ставке рефинансирования ЦБ, объёму кредитов и депозитов и кредитному риску банка.&lt;br&gt;Файл уходит почтой в бэк-офис депозитов.&lt;br&gt;Для спецставки сотрудник смотрит кредитный риск клиента в своём разделе АБС и отвечает письмом.&lt;br&gt;К депозитным данным прямого доступа нет." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1124" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="45" value="Кредитный конвейер (Camunda): сотрудник рассматривает заявку и принимает решение по результату скоринга и параметрам заявки.&lt;br&gt;Скоринг вызывается из конвейера по API.&lt;br&gt;Заявки приходят из АБС выгрузкой базы раз в сутки.&lt;br&gt;Одобрение возвращается в АБС раз в сутки, АБС зачисляет деньги на счёт клиента." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="1124" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="46" value="АБС: кредитный договор и платежи по нему.&lt;br&gt;Номера платежей по договору хранятся в кредитном конвейере." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1630" y="1124" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="47" value="Управление IT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef8;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1354" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="48" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="1354" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="49" value="Сопровождение. Систему кол-центра ведёт подрядчик, она стоит в инфраструктуре банка.&lt;br&gt;Команда АБС может точечно менять её на Java." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="550" y="1354" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="50" value="Сопровождение. SMS-шлюз банка.&lt;br&gt;Наружу сообщения уходят через телеком-оператора." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="1354" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="51" value="Сопровождение. АБС — собственная разработка банка: десктоп на Delphi, Oracle, логика на PL/SQL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1354" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="52" value="Сопровождение. Кредитный конвейер: Camunda и Oracle, дорабатывают подрядчик и свои сотрудники.&lt;br&gt;Скоринг: Python, Flask, PostgreSQL, делает IT-отдел. Источники данных — АБС и бюро кредитных историй." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="1354" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="53" value="Интернет-банк: ASP.NET MVC на .NET Framework 4.5, MS SQL, монолит на платформе подрядчика.&lt;br&gt;Сейчас проводит платежи и открытие текущих счетов через прямую работу с базой АБС.&lt;br&gt;Депозиты и кредиты не обслуживает.&lt;br&gt;Одна группа серверов в ЦОД и резервный ЦОД." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#1a1a1a;strokeColor=#b0b8c4;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1630" y="1354" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="54" value="Команда цифровой трансформации розничного бизнеса" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8eef8;fontColor=#1a1a1a;strokeColor=#7f9cc4;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1584" width="250" height="230" as="geometry"/></mxCell>
<mxCell id="55" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="1584" width="270" height="230" as="geometry"/></mxCell>
<mxCell id="56" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f4f6;fontColor=#9aa0a6;strokeColor=#b0b8c4;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1584" width="270" height="230" as="geometry"/></mxCell>
